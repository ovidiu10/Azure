# Copy this file to .env and fill in the backend you're using.
# Never commit the real .env — it's already in .gitignore.

# --- Model provider selector ---
# "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# --- Backend selector (provider=anthropic only) ---
# "anthropic" (default) or "foundry"
CLAUDE_BACKEND=anthropic

# --- Direct Anthropic API ---
ANTHROPIC_API_KEY=

# --- Azure Foundry (Claude models) ---
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
# ANTHROPIC_FOUNDRY_BASE_URL=   # alternative to RESOURCE

# --- Azure Foundry (OpenAI models; provider=openai, Foundry-hosted only) ---
OPENAI_FOUNDRY_API_KEY=
OPENAI_FOUNDRY_RESOURCE=
